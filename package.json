{
  "name": "filapro-leads",
  "version": "1.46.8",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "db:migrate": "pnpm --filter @filapro/db migrate:dev",
    "db:seed": "pnpm --filter @filapro/db seed",
    "worker": "pnpm --filter worker dev",
    "test:worker": "pnpm --filter worker test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "esbuild"
    ],
    "overrides": {
      "postcss@<8.5.23": "^8.5.23",
      "effect@<3.22.1": "^3.22.1"
    }
  }
}
