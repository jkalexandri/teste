# /etc/caddy/Caddyfile — HTTPS automático (decisão #99)

# Site
filaproleads.com.br {
	encode zstd gzip
	request_body {
		max_size 25MB
	}
	reverse_proxy 127.0.0.1:3000
	# Nos segundos em que o site reinicia (atualização — decisão #103): página "Sistema em atualização"
	handle_errors {
		@fora expression `{err.status_code} in [502, 503, 504]`
		handle @fora {
			root * /opt/filapro/app/deploy/pagina-manutencao
			rewrite * /index.html
			file_server
		}
	}
}

# www vai para o endereço principal
www.filaproleads.com.br {
	redir https://filaproleads.com.br{uri} permanent
}

# Serviço 24/7 (decisão #134): o site fala com ele POR DENTRO da VPS (WORKER_URL=http://127.0.0.1:4000).
# Pela internet, este endereço responde só "/saude" (está no ar?); o resto é negado, mesmo com o token.
api.filaproleads.com.br {
	@saude path /saude
	handle @saude {
		reverse_proxy 127.0.0.1:4000
	}
	handle {
		respond "Acesso negado." 403
	}
}
