// Modelo de dados do FilaPro Leads — etapa 2 (empresas, usuários e sessões).
// Regras em docs/decisoes.md. Comentários em português.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Módulos do sistema. Individual e Empresarial não se comunicam.
enum Modulo {
  INDIVIDUAL
  EMPRESARIAL
}

/// Papéis. Admin da Empresa NÃO envia mensagens e NÃO usa API/WhatsApp.
enum Cargo {
  SUPERADMIN
  ADMIN_EMPRESA
  USUARIO
}

enum StatusUsuario {
  ATIVO
  BLOQUEADO
}

/// Conta que compra o pacote. No módulo Individual, cada usuário tem a sua
/// própria conta (limite de 1 usuário). No Empresarial, todos os usuários da
/// empresa compartilham o mesmo pacote e expiram juntos (decisão #13).
model Empresa {
  id              String   @id @default(cuid())
  nome            String
  modulo          Modulo
  pacote          String
  limiteUsuarios  Int
  ativa           Boolean  @default(true)
  expiraEm        DateTime
  prazoDias       Int      @default(31)
  /// Plano de origem (compra/renovação). Vazio em contas criadas manualmente.
  planoId         String?
  /// Limite de disparos do teste grátis (Free — decisão #34). Vazio = sem limite.
  limiteDisparos  Int?
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt
  usuarios        Usuario[]
  pedidos         Pedido[]

  @@index([modulo])
}

model Usuario {
  id                 String        @id @default(cuid())
  nome               String
  email              String        @unique
  cargo              Cargo
  status             StatusUsuario @default(ATIVO)
  whatsapp           String?
  /// Super Admin não pertence a nenhuma empresa.
  empresaId          String?
  empresa            Empresa?      @relation(fields: [empresaId], references: [id])

  /// Senha definitiva (hash). Vazia até o primeiro acesso.
  senhaHash          String?
  /// Senha temporária (hash) enviada por e-mail. Obriga a troca no primeiro acesso (decisão #12).
  senhaTempHash      String?
  senhaTempExpiraEm  DateTime?

  /// Bloqueio após 5 senhas erradas, por 15 minutos (decisão #14).
  tentativasFalhas   Int           @default(0)
  bloqueadoAte       DateTime?

  ultimoAcesso       DateTime?
  criadoEm           DateTime      @default(now())
  atualizadoEm       DateTime      @updatedAt
  sessoes            Sessao[]

  @@index([empresaId])
}

/// Sessão de login. O cookie é de sessão (some ao fechar o navegador — decisão #10).
/// Guardamos só o hash do token.
model Sessao {
  id              String   @id @default(cuid())
  tokenHash       String   @unique
  usuarioId       String
  usuario         Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  /// true enquanto o usuário entrou com senha temporária e ainda não trocou.
  precisaTrocar   Boolean  @default(false)
  criadoEm        DateTime @default(now())
  expiraEm        DateTime

  @@index([usuarioId])
}

/// Catálogo de planos exibido no popup "Planos" do login (decisões #22, #26, #27).
/// Todo o conteúdo é editado pelo Super Admin. Valores em centavos.
model Plano {
  id              String   @id @default(cuid())
  slug            String   @unique
  nome            String
  modulo          Modulo
  /// Quantidade de usuários do pacote (o Admin da Empresa não conta — decisão #23).
  /// Vazio no Personalizado (definido pelo Super Admin em cada empresa).
  usuarios        Int?
  gratis          Boolean  @default(false)
  personalizado   Boolean  @default(false)
  precoAntigo     Int?
  precoAtual      Int?
  periodo         String   @default("mês")
  prazoDias       Int      @default(31)
  /// Limites do teste grátis (só no Free — decisão #34).
  testeDias       Int?
  testeDisparos   Int?
  selo            String   @default("")
  frase           String   @default("")
  condicoes       String   @default("")
  ofertaTexto     String   @default("")
  recursos        String[] @default([])
  textoBotao      String   @default("Escolher plano")
  visivel         Boolean  @default(false)
  destaque        Boolean  @default(false)
  ordem           Int      @default(0)
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt
}

/// Configurações de venda (registro único, id = "config").
model ConfigVenda {
  id                    String   @id @default("config")
  /// Formas de pagamento ativas. Por enquanto só PIX (decisão #29).
  formasPagamento       String[] @default(["PIX"])
  chavePix              String   @default("")
  nomeRecebedor         String   @default("")
  cidadeRecebedor       String   @default("")
  /// Contato do plano Personalizado (decisão #35), ex.: WhatsApp.
  contatoPersonalizado  String   @default("")
  atualizadoEm          DateTime @updatedAt
}

enum StatusPedido {
  AGUARDANDO
  PAGO
  CANCELADO
  EXPIRADO
}

/// Pedido de compra feito pelo popup "Planos" (decisões #32, #33, #37).
/// PIX com confirmação manual pelo Super Admin.
model Pedido {
  id              String       @id @default(cuid())
  /// Código curto mostrado ao cliente e usado como identificador do PIX.
  codigo          String       @unique
  status          StatusPedido @default(AGUARDANDO)
  /// Cópia dos dados do plano no momento da compra.
  planoId         String
  planoNome       String
  modulo          Modulo
  usuarios        Int?
  prazoDias       Int
  valor           Int
  /// Dados do comprador
  nome            String
  email           String
  whatsapp        String
  empresaNome     String?
  pixCopiaECola   String
  expiraEm        DateTime
  criadoEm        DateTime     @default(now())
  confirmadoEm    DateTime?
  confirmadoPor   String?
  canceladoEm     DateTime?
  /// Conta criada na confirmação
  empresaId       String?
  empresa         Empresa?     @relation(fields: [empresaId], references: [id])

  @@index([status])
  @@index([email])
}

/// E-mails que já usaram o teste grátis (1 teste por e-mail — decisão #34).
model TesteGratisUsado {
  email     String   @id
  usadoEm   DateTime @default(now())
}
