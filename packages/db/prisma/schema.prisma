// Modelo de dados do FilaPro Leads — etapa 2 (empresas, usuários e sessões).
// Regras em docs/decisoes.md. Comentários em português.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Módulos do sistema. Individual e Empresarial não se comunicam.
enum Modulo {
  INDIVIDUAL
  EMPRESARIAL
}

/// Papéis. Admin da Empresa NÃO envia mensagens e NÃO usa API/WhatsApp.
enum Cargo {
  SUPERADMIN
  ADMIN_EMPRESA
  USUARIO
}

enum StatusUsuario {
  ATIVO
  BLOQUEADO
}

/// Conta que compra o pacote. No módulo Individual, cada usuário tem a sua
/// própria conta (limite de 1 usuário). No Empresarial, todos os usuários da
/// empresa compartilham o mesmo pacote e expiram juntos (decisão #13).
model Empresa {
  id              String   @id @default(cuid())
  /// Código legível (decisão #63): "E00001" (empresa) ou "00001" (conta individual).
  codigo          String?  @unique
  nome            String
  modulo          Modulo
  pacote          String
  limiteUsuarios  Int
  ativa           Boolean  @default(true)
  expiraEm        DateTime
  prazoDias       Int      @default(31)
  /// Cobrança automática no cartão (decisão #124): código da assinatura no Asaas; vazio = desligada
  asaasAssinaturaId String? @unique
  /// Plano de origem (compra/renovação). Vazio em contas criadas manualmente.
  planoId         String?
  /// Limite de disparos do teste grátis (Free — decisão #34). Vazio = sem limite.
  limiteDisparos  Int?
  /// Limite de leads da conta (decisão #58). Vazio = ilimitado.
  limiteLeads     Int?
  /// Treinamento da IA (decisão #77): liga/desliga e limites da conta (copiados do plano; o Super Admin pode ajustar)
  treinarIA         Boolean @default(true)
  /// Leads de anúncios (recurso pago — decisões #90 e #94): copiado do plano; o Super Admin liga/desliga por conta
  leadsAnuncios     Boolean @default(false)
  /// WhatsApps extras contratados (Individual — decisões #79, #80 e #95); vencem junto com o plano
  whatsappsExtras   Int     @default(0)
  /// Pacotes de usuários do plano (decisão #113): limites de usuários, leads e disparos = plano × pacotes
  pacotes         Int       @default(1)
  /// Período atual de disparos (decisão #102): começa na compra/renovação; disparos de pacotes extras do período
  inicioPeriodo     DateTime @default(now())
  disparosExtras    Int      @default(0)
  limiteMateriais   Int?
  limitePaginasMes  Int?
  /// Janela de envio da conta (decisões #6 e #65), em minutos do dia (480 = 8h). Segunda a sábado.
  janelaInicio    Int      @default(480)
  janelaFim       Int      @default(1200)
  /// Renovação (decisões #42–#44): token do link e controle dos avisos do ciclo atual.
  tokenRenovacao      String?   @unique
  avisoRenovacao10Em  DateTime?
  avisoRenovacao3Em   DateTime?
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt
  usuarios        Usuario[]
  pedidos         Pedido[]
  leads           Lead[]
  campanhas       Campanha[]
  ficha           FichaEmpresa?

  @@index([modulo])
  /// CPF/CNPJ de quem paga a conta (decisão #115): guardado na confirmação do 1º pedido pelo Asaas
  cpfCnpj         String?
}

model Usuario {
  id                 String        @id @default(cuid())
  /// Código legível (decisão #63): "S00001" (Super Admin), "EU00001" (usuário de empresa) ou "00001" (individual).
  codigo             String?       @unique
  nome               String
  email              String        @unique
  cargo              Cargo
  status             StatusUsuario @default(ATIVO)
  whatsapp           String?
  /// Telas liberadas pelo Admin da Empresa (decisão #47). Dashboard e WhatsApp sempre liberados.
  permissoes         String[]      @default(["leads", "campanhas", "conversas", "arquivos", "empresa-ia"])
  /// Limite de leads do usuário, definido pelo Admin da Empresa (decisão #58). Vazio = ilimitado.
  limiteLeads        Int?
  /// Conversas IA (decisão #92): a IA responde sozinha os leads deste usuário (liga/desliga geral)
  iaConversas        Boolean       @default(true)
  /// Avisos do usuário (decisões #81 e #94): número que recebe e liga/desliga de cada tipo
  numeroAvisos       String?
  avisoQuente        Boolean       @default(true)
  avisoAnuncio       Boolean       @default(true)
  avisoRespondeu     Boolean       @default(true)
  /// Quando saiu o último aviso (resumo a cada 10 minutos — decisão #94)
  ultimoAvisoEm      DateTime?
  /// Endereço secreto de leads de anúncios (decisão #82)
  tokenAnuncios      String?       @unique
  /// Notificações no celular (app — decisão #99): ligado/desligado e os aparelhos inscritos
  avisoCelular       Boolean       @default(true)
  /// Menu Online (decisão #102): último sinal do navegador/app, tela atual e aparelho
  vistoEm            DateTime?
  telaAtual          String?
  /// Verificação em duas etapas (decisão #105): segredo do app autenticador (criptografado), se está ativa
  /// e os códigos de recuperação (hash; cada um vale uma vez)
  doisFatoresSegredo String?
  doisFatoresAtivo   Boolean       @default(false)
  doisFatoresCodigos String[]      @default([])
  /// Último intervalo de 30 s do código TOTP já aceito: cada código vale uma vez (decisão #161 — S6 do Módulo 1)
  doisFatoresUltimoPasso Int?
  /// Link de uso único para definir a senha (recuperação): só o hash do código; vale 30 min (decisão #164 — S9 do Módulo 1)
  linkSenhaHash      String?       @unique
  linkSenhaExpiraEm  DateTime?
  aparelho           String?
  /// Super Admin não pertence a nenhuma empresa.
  empresaId          String?
  empresa            Empresa?      @relation(fields: [empresaId], references: [id])

  /// Senha definitiva (hash). Vazia até o primeiro acesso.
  senhaHash          String?
  /// Senha temporária (hash) enviada por e-mail. Obriga a troca no primeiro acesso (decisão #12).
  senhaTempHash      String?
  senhaTempExpiraEm  DateTime?

  /// Bloqueio após 5 senhas erradas, por 15 minutos (decisão #14).
  tentativasFalhas   Int           @default(0)
  bloqueadoAte       DateTime?

  ultimoAcesso       DateTime?
  criadoEm           DateTime      @default(now())
  atualizadoEm       DateTime      @updatedAt
  sessoes            Sessao[]
  /// Números de WhatsApp do usuário (o principal tem o id do usuário; extras só no Individual — decisões #79 e #95)
  whatsapp_sessoes   WhatsappSessao[]
  leads              Lead[]
  campanhas          Campanha[]
  arquivos           Arquivo[]

  @@index([empresaId])
}

/// Sessão de login. O cookie é de sessão (some ao fechar o navegador — decisão #10).
/// Guardamos só o hash do token.
model Sessao {
  id              String   @id @default(cuid())
  tokenHash       String   @unique
  usuarioId       String
  usuario         Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  /// true enquanto o usuário entrou com senha temporária e ainda não trocou.
  precisaTrocar   Boolean  @default(false)
  /// Senha certa, falta o código da verificação em duas etapas (decisão #105): a sessão ainda não vale
  pendente2fa     Boolean  @default(false)
  tentativas2fa   Int      @default(0)
  criadoEm        DateTime @default(now())
  expiraEm        DateTime

  @@index([usuarioId])
}

/// Catálogo de planos exibido no popup "Planos" do login (decisões #22, #26, #27).
/// Todo o conteúdo é editado pelo Super Admin. Valores em centavos.
model Plano {
  id              String   @id @default(cuid())
  slug            String   @unique
  nome            String
  modulo          Modulo
  /// Quantidade de usuários do pacote (o Admin da Empresa não conta — decisão #23).
  /// Vazio no Personalizado (definido pelo Super Admin em cada empresa).
  usuarios        Int?
  gratis          Boolean  @default(false)
  personalizado   Boolean  @default(false)
  precoAntigo     Int?
  precoAtual      Int?
  periodo         String   @default("mês")
  prazoDias       Int      @default(31)
  /// Limites do teste grátis (só no Free — decisão #34).
  testeDias       Int?
  testeDisparos   Int?
  /// Limite de leads do plano (decisão #58). Vazio = ilimitado.
  limiteLeads     Int?
  /// Limite mensal de gasto com IA por conta, em dólar (decisão #74, uso futuro). Vazio = ilimitado.
  limiteIAUsd     Float?
  /// Limites de treinamento da IA (decisão #77). Vazio = ilimitado.
  limiteMateriais   Int?
  limitePaginasMes  Int?
  /// Leads de anúncios incluídos neste plano (decisão #90)
  leadsAnuncios     Boolean @default(false)
  /// WhatsApp extra (só Individual — decisões #79 e #80): máximo de números por usuário (contando o principal) e preço de cada extra (centavos, por período)
  maxWhatsapps      Int     @default(1)
  precoWhatsappExtra Int?
  /// Preço por quantidade (decisão #113): desconto (%) do 2º, 3º, 4º e 5º item — números de WhatsApp (Individual)
  /// ou pacotes de usuários (Empresarial). Depois do último, vale o último.
  descontos         Float[] @default([10, 15, 20, 25])
  /// Empresarial: quantos pacotes de "usuarios" a empresa pode escolher (1 = fixo; Padrão 10→50 = 5)
  maxPacotes        Int     @default(1)
  /// Plano por quantidade de envio (decisão #102): disparos por período (vazio = sem limite) e pacote extra (quantidade e preço em centavos)
  disparosPorPeriodo   Int?
  pacoteDisparos       Int?
  precoPacoteDisparos  Int?
  selo            String   @default("")
  frase           String   @default("")
  condicoes       String   @default("")
  ofertaTexto     String   @default("")
  recursos        String[] @default([])
  textoBotao      String   @default("Escolher plano")
  visivel         Boolean  @default(false)
  destaque        Boolean  @default(false)
  ordem           Int      @default(0)
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt
}

/// Configurações de venda (registro único, id = "config").
model ConfigVenda {
  id                    String   @id @default("config")
  /// Formas de pagamento ativas. Por enquanto só PIX (decisão #29).
  formasPagamento       String[] @default(["PIX"])
  chavePix              String   @default("")
  nomeRecebedor         String   @default("")
  cidadeRecebedor       String   @default("")
  /// Contato do plano Personalizado (decisão #35), ex.: WhatsApp.
  contatoPersonalizado  String   @default("")
  /// WhatsApp do Super Admin que recebe os avisos de novo pedido (decisão #38).
  numeroAvisos          String   @default("")
  /// Cotação do dólar informada pelo Super Admin, para mostrar as despesas com IA em reais (decisão #77)
  cotacaoDolar          Float?
  /// Gestão financeira (decisão #106): alíquota do imposto previsto (% sobre o faturamento recebido no mês)
  aliquotaImposto       Float?
  /// Último aviso de contas vencendo (no máximo 1 por dia)
  avisoFinanceiroEm     DateTime?
  /// Asaas (decisão #115): ambiente ("sandbox" = testes, "producao"), chave de API e token do aviso (webhook), ambos criptografados
  asaasAmbiente         String    @default("sandbox")
  asaasChave            String?
  asaasTokenWebhook     String?
  /// Último teste de conexão que deu certo: nome da conta no Asaas e quando
  asaasConta            String?
  asaasTestadoEm        DateTime?
  /// IA responde o suporte dos clientes pelo botão Suporte (decisão #146). Começa desligada.
  iaSuporteLigada       Boolean  @default(false)
  /// Chaves gerais da IA (decisão #149). Ligadas por padrão: Leads (Conversas IA), Campanhas (gerar mensagens) e Visitante (chat da tela de Planos)
  iaLeadsLigada         Boolean  @default(true)
  iaCampanhasLigada     Boolean  @default(true)
  iaVisitanteLigada     Boolean  @default(true)
  /// Texto sugestão do "Como qualificar os leads" (decisão #121), editado pelo Super Admin; vazio = texto padrão do sistema
  sugestaoQualificar    String?
  /// Último aviso (webhook) que chegou do Asaas: quando, qual evento e se o token conferiu — para conferir na tela Pagamento
  asaasAvisoEm          DateTime?
  asaasAvisoEvento      String?
  asaasAvisoOk          Boolean?
  /// Juros do parcelamento no cartão (decisão #115, item j): % ao mês definido pelo Super Admin.
  /// Vazio = sem parcelamento; 0 = parcelas sem juros. Vale para planos trimestrais e anuais, até 6x.
  jurosParcelaMes       Float?
  atualizadoEm          DateTime @updatedAt
}

enum StatusPedido {
  AGUARDANDO
  PAGO
  CANCELADO
  EXPIRADO
}

/// Pedido de compra feito pelo popup "Planos" (decisões #32, #33, #37).
/// PIX com confirmação manual pelo Super Admin.
model Pedido {
  id              String       @id @default(cuid())
  /// Código curto mostrado ao cliente e usado como identificador do PIX.
  codigo          String       @unique
  status          StatusPedido @default(AGUARDANDO)
  /// true = renova a conta existente (empresaId já vem preenchido) — decisão #44.
  renovacao       Boolean      @default(false)
  /// Cópia dos dados do plano no momento da compra.
  planoId         String
  planoNome       String
  modulo          Modulo
  usuarios        Int?
  prazoDias       Int
  valor           Int
  /// Dados do comprador
  nome            String
  email           String
  whatsapp        String
  empresaNome     String?
  pixCopiaECola   String
  expiraEm        DateTime
  criadoEm        DateTime     @default(now())
  confirmadoEm    DateTime?
  confirmadoPor   String?
  canceladoEm     DateTime?
  /// WhatsApp extra (decisões #80 e #95): quantos extras este pedido inclui; "somenteExtras" = compra no meio do período
  whatsappsExtras Int          @default(0)
  /// Pacotes de usuários comprados (Empresarial — decisão #113); "usuarios" já é o total (pacote × quantidade)
  pacotes         Int          @default(1)
  somenteExtras   Boolean      @default(false)
  /// Disparos extras deste pedido (pacotes × quantidade do pacote — decisão #102)
  pacotesDisparos Int          @default(0)
  /// Renovação com menos extras: números que o cliente escolheu manter
  manterSessoes   String[]     @default([])
  /// Forma de pagamento (decisão #115): PIX_MANUAL (chave PIX própria), PIX, BOLETO ou CARTAO (pelo Asaas)
  forma           String       @default("PIX_MANUAL")
  /// Parcelas no cartão (1 = à vista) e CPF/CNPJ de quem paga (exigido pelo Asaas)
  parcelas        Int          @default(1)
  cpfCnpj         String?
  /// Cobrança no Asaas: código, página de pagamento (cartão/fatura), boleto (link e linha digitável)
  asaasId         String?      @unique
  /// Cobrança automática no cartão (decisão #124): pedido de assinatura (1º pagamento ou renovação de cada período)
  automatica      Boolean      @default(false)
  /// Assinatura no Asaas criada por este pedido (1º pagamento) ou da qual ele faz parte
  asaasAssinaturaId String?
  /// Upgrade feito pelo dono dentro do sistema (decisão #125): soma os dias (e os disparos que sobraram, entre planos por disparo);
  /// vindo do Free, começa hoje
  upgrade         Boolean      @default(false)
  linkPagamento   String?
  boletoLinha     String?
  /// Receita e estorno na gestão financeira (decisão #106)
  lancamentos     Lancamento[]
  /// Conta criada na confirmação
  empresaId       String?
  empresa         Empresa?     @relation(fields: [empresaId], references: [id])

  @@index([status])
  @@index([email])
}

/// E-mails que já usaram o teste grátis (1 teste por e-mail — decisão #34).
model TesteGratisUsado {
  email     String   @id
  usadoEm   DateTime @default(now())
}

enum StatusWhatsapp {
  DESCONECTADO
  CONECTANDO
  AGUARDANDO_QR
  CONECTADO
  /// Caiu e está voltando sozinho, com o login salvo (decisão #139)
  RECONECTANDO
}

/// Sessão do WhatsApp (API própria, conexão por QR Code — decisões #1 e #18).
/// id = id do usuário, ou "plataforma" para o número que envia os avisos do sistema.
/// O serviço 24/7 (apps/worker, na VPS) mantém a conexão e atualiza este registro;
/// as telas leem daqui. Credenciais guardadas CRIPTOGRAFADAS.
model WhatsappSessao {
  id            String         @id
  usuarioId     String?
  usuario       Usuario?       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  /// Apelido opcional do número (decisão #95) e ordem na tela
  apelido       String         @default("")
  ordem         Int            @default(0)
  /// Número extra que saiu na renovação: QR bloqueado até comprar de novo (decisão #95)
  bloqueada     Boolean        @default(false)
  status        StatusWhatsapp @default(DESCONECTADO)
  numero        String?
  /// QR Code atual (texto) enquanto aguarda a leitura.
  qr            String?
  qrEm          DateTime?
  /// Credenciais da sessão (criptografadas com AES-256-GCM).
  creds         String?
  erro          String?
  conectadoEm   DateTime?
  /// Última reconexão depois de queda ou de reinício do serviço (decisão #155 — B2): "Conectado desde" mantém a data da conexão de verdade
  reconectadoEm DateTime?
  /// Primeira conexão deste número (aquecimento de número novo — decisão #64)
  primeiraConexaoEm DateTime?
  /// De qual telefone é a idade do aquecimento (decisão #141): chip diferente no mesmo espaço recomeça o aquecimento
  numeroAquecimento String?
  /// Reconexão automática (decisão #139): quando caiu, qual tentativa e quando é a próxima
  quedaEm            DateTime?
  tentativaReconexao Int       @default(0)
  proximaTentativaEm DateTime?
  /// Aviso de número caído (decisão #142): quando avisou da queda (3 min) e do problema (2 h). Um aviso de cada por queda.
  avisoQuedaEm       DateTime?
  avisoProblemaEm    DateTime?
  atualizadoEm  DateTime       @updatedAt
  chaves        WhatsappChave[]

  @@index([usuarioId])
}

/// Chaves de criptografia do WhatsApp da sessão (criptografadas).
model WhatsappChave {
  sessaoId  String
  sessao    WhatsappSessao @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  tipo      String
  chaveId   String
  valor     String

  @@id([sessaoId, tipo, chaveId])
}

/// Contadores dos códigos legíveis (decisão #63). Um registro por tipo.
model Contador {
  tipo   String @id
  valor  Int    @default(0)
}

/// Status do lead (decisão #59). Muda pela conversa; o usuário pode alterar.
enum StatusLead {
  NOVO
  EM_CONVERSA
  QUALIFICADO
  OBJECAO
  VENDA_CONCLUIDA
  BLOQUEADO_24H
  PEDIU_SAIR
}

/// Lead (etapa 7 — decisões #53 a #59 e #63).
/// O mesmo telefone não se repete dentro da conta (empresa ou conta individual).
model Lead {
  id                  String     @id @default(cuid())
  /// "L00001" (conta individual / Super Admin) ou "EL00001" (empresa).
  codigo              String     @unique
  /// Nome pode ficar em branco (decisão #61).
  nome                String     @default("")
  /// Só dígitos, com código do país (ex.: 5511987654321).
  telefone            String
  status              StatusLead @default(NOVO)
  ativo               Boolean    @default(true)
  /// "Pediu para sair": envio bloqueado por 45 dias a partir daqui (decisão #57).
  pediuSairEm         DateTime?
  /// Última resposta do lead (limite de 2 mensagens sem resposta em 30 dias — decisão #64)
  ultimaRespostaEm    DateTime?
  /// Qualificação da IA (etapa 10).
  qualificacao        String?
  qualificacaoMotivo  String?
  qualificacaoEm      DateTime?
  /// Conversas IA (etapa 10 — decisão #92): IA pausada nesta conversa ("Assumir conversa", não soube responder, limite do dia)
  iaPausada           Boolean    @default(false)
  iaPausaMotivo       String?
  /// Resumo da conversa feito pela IA (economia — decisão #75) e até quando ele cobre
  resumoConversa      String     @default("")
  resumidoAte         DateTime?
  ultimaMensagemEm    DateTime?
  naoLidas            Int        @default(0)
  /// Número com que o lead está conversando (a conversa continua por ele — decisões #79 e #95)
  sessaoId            String?
  mensagens           Mensagem[]
  /// Dono do lead
  usuarioId           String
  usuario             Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  /// Conta (vazio só nos leads do próprio Super Admin)
  empresaId           String?
  empresa             Empresa?   @relation(fields: [empresaId], references: [id])
  /// Cópias dos códigos para leitura direta no banco (decisão #63)
  codigoUsuario       String
  codigoEmpresa       String?
  criadoEm            DateTime   @default(now())
  atualizadoEm        DateTime   @updatedAt
  envios              Envio[]

  @@unique([empresaId, telefone])
  @@unique([usuarioId, telefone])
  @@index([usuarioId])
  @@index([empresaId])
  /// Resposta da IA pendente (decisão #127): fica no banco, então reiniciar o serviço ou reconectar o WhatsApp não perde nem adia.
  /// "respostaPendenteDesde" = 1ª mensagem do lead ainda sem resposta; "responderEm" = quando responder (espera de 8–15 s, teto de 30 s)
  respostaPendenteDesde DateTime?
  responderEm         DateTime?
  /// Sobe a cada mensagem nova do lead: a resposta só "fecha" a pendência se nada novo chegou enquanto a IA respondia
  pendenteVersao      Int        @default(0)
  /// Tentativas seguidas que falharam (IA ou envio); na 3ª vai a mensagem reserva e o usuário é avisado
  tentativasResposta  Int        @default(0)
  /// Aviso "WhatsApp desconectado com lead esperando" já enviado nesta pendência
  avisoEsperaEm       DateTime?
  /// Endereço exato do WhatsApp de onde o lead escreveu por último (ex.: "123…@lid"); as respostas vão para ele (decisão #129)
  jidWhatsapp           String?

  @@index([usuarioId, ultimaMensagemEm])
  @@index([responderEm])
}

enum AutorMensagem {
  LEAD
  IA
  USUARIO
  CAMPANHA
}

/// Mensagem de uma conversa (etapa 10 — decisão #92). Guardada por até 365 dias.
model Mensagem {
  id          String        @id @default(cuid())
  leadId      String
  lead        Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  autor       AutorMensagem
  texto       String        @default("")
  /// texto, imagem, audio, video, documento ou outro
  tipo        String        @default("texto")
  /// Anexo enviado pelo usuário/campanha (id do Arquivo) ou nome do arquivo recebido
  arquivoId   String?
  arquivoNome String?
  /// Número que enviou/recebeu
  sessaoId    String?
  criadoEm    DateTime      @default(now())

  @@index([leadId, criadoEm])
  @@index([criadoEm])
}

/// Regras globais de envio, controladas pelo Super Admin (decisão #65). Registro único (id = "config").
model ConfigEnvio {
  id            String   @id @default("config")
  /// Faixa permitida para qualquer janela (minutos do dia). Padrão 7h–21h.
  horaMinima    Int      @default(420)
  horaMaxima    Int      @default(1260)
  /// Feriados: "MM-DD" (todo ano), "AAAA-MM-DD" (data única) ou "SEXTA-SANTA" (calculada).
  feriados      String[] @default(["01-01", "SEXTA-SANTA", "04-21", "05-01", "09-07", "10-12", "11-02", "11-15", "11-20", "12-25"])
  /// Janela do próprio Super Admin quando ele envia (decisão #62).
  janelaInicioSuperAdmin Int @default(480)
  janelaFimSuperAdmin    Int @default(1200)
  atualizadoEm  DateTime @updatedAt
}

enum StatusCampanha {
  RASCUNHO
  AGENDADA
  EM_ANDAMENTO
  PAUSADA
  CONCLUIDA
  CANCELADA
}

enum ModoAntibloqueio {
  CONSERVADOR
  EQUILIBRADO
  RAPIDO
}

/// Campanha (etapa 8 — prompt seções 8 e 9, decisões #64 a #68).
model Campanha {
  id                 String           @id @default(cuid())
  usuarioId          String
  usuario            Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresaId          String?
  empresa            Empresa?         @relation(fields: [empresaId], references: [id])
  /// Números escolhidos para enviar (rodízio — decisão #79). Vazio = o número principal.
  sessoes            String[]         @default([])
  status             StatusCampanha   @default(RASCUNHO)
  assunto            String           @default("")
  /// Mensagem de Referência (base para a IA na etapa 9)
  referencia         String           @default("")
  mensagem           String           @default("")
  /// Variações 1, 2 e 3 (escritas à mão na etapa 8 — decisão #68)
  variacoes          String[]         @default([])
  /// Regras do Antibloqueio
  modo               ModoAntibloqueio @default(CONSERVADOR)
  bloqueio24h        Boolean          @default(true)
  descadastro        Boolean          @default(true)
  textoDescadastro   String           @default("")
  incluirDataHora    Boolean          @default(false)
  eliminarDuplicados Boolean          @default(true)
  randomizar         Boolean          @default(true)
  /// Leads: "todos" (todos os ativos) ou lista escolhida
  selecaoTodos       Boolean          @default(true)
  selecaoStatus      String[]         @default([])
  leadsEscolhidos    String[]         @default([])
  /// Leads que pediram para sair há mais de 45 dias e o usuário decidiu manter (decisão #57)
  manterQuemSaiu     String[]         @default([])
  /// Anexo (decisão #67)
  arquivoId          String?
  arquivo            Arquivo?         @relation(fields: [arquivoId], references: [id], onDelete: SetNull)
  agendadaPara       DateTime?
  iniciadaEm         DateTime?
  concluidaEm        DateTime?
  canceladaEm        DateTime?
  motivo             String?
  /// Último aviso automático enviado ao usuário pelo WhatsApp da plataforma ("tipo|AAAA-MM-DD"), para não repetir (decisão #70)
  ultimoAviso        String?
  /// true = o usuário quer ser avisado SEMPRE que houver problema; false = padrão, no máximo 1 aviso por dia de cada tipo (decisão #71)
  avisarSempre       Boolean          @default(false)
  totalLeads         Int              @default(0)
  criadoEm           DateTime         @default(now())
  atualizadoEm       DateTime         @updatedAt
  envios             Envio[]

  @@index([usuarioId, status])
  @@index([status])
}

enum StatusEnvio {
  PENDENTE
  ENVIADO
  FALHOU
  PULADO
}

/// Um envio por lead da campanha (fila guardada no PostgreSQL — decisão #68).
model Envio {
  id           String      @id @default(cuid())
  campanhaId   String
  campanha     Campanha    @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  leadId       String?
  lead         Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  telefone     String
  nome         String      @default("")
  status       StatusEnvio @default(PENDENTE)
  motivo       String?
  /// Qual texto foi usado: 0 = principal, 1..3 = variações
  versao       Int?
  /// Número que enviou (limites e saúde por número — decisão #79)
  sessaoId     String?
  ordem        Int         @default(0)
  enviadoEm    DateTime?
  criadoEm     DateTime    @default(now())

  @@unique([campanhaId, telefone])
  @@index([campanhaId, status, ordem])
  @@index([telefone, enviadoEm])
}

/// Arquivos enviados pelo usuário para anexar nas campanhas (decisão #67). O arquivo fica na VPS.
model Arquivo {
  id         String     @id @default(cuid())
  usuarioId  String
  usuario    Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nome       String
  tipo       String
  tamanho    Int
  criadoEm   DateTime   @default(now())
  campanhas  Campanha[]

  @@index([usuarioId])
}

/// Configuração da IA para cada tarefa (decisões #72 e #75). Trocável pelo Super Admin sem mexer no código.
/// tarefa: "gerar_mensagens" | "aprender" | "qualificar" | "conversar"
model ConfigIA {
  tarefa        String   @id
  /// "anthropic" (Claude) | "compativel" (padrão compatível) | "simulado" (só testes)
  provedor      String   @default("anthropic")
  modelo        String   @default("claude-haiku-5-5")
  /// Endereço do provedor no "padrão compatível" (ex.: https://api.openai.com/v1)
  urlBase       String   @default("")
  /// Chave de acesso, criptografada (AES-256-GCM)
  chave         String?
  /// Preço em dólar por 1 milhão de tokens (para calcular o custo)
  precoEntrada  Float    @default(0.1)
  precoSaida    Float    @default(0.5)
  atualizadoEm  DateTime @updatedAt
}

/// Cada chamada à IA, com tokens e custo (tela de despesas — decisão #77).
model UsoIA {
  id            String   @id @default(cuid())
  criadoEm      DateTime @default(now())
  tarefa        String
  provedor      String
  modelo        String
  empresaId     String?
  usuarioId     String?
  entrada       Int      @default(0)
  saida         Int      @default(0)
  cacheLeitura  Int      @default(0)
  cacheEscrita  Int      @default(0)
  custoUsd      Float    @default(0)
  ok            Boolean  @default(true)
  erro          String?

  @@index([criadoEm])
  @@index([empresaId, criadoEm])
}

/// Dados do responsável pelo FilaPro Leads usados na Política de Privacidade e nos Termos de Uso
/// (decisão #88). Preenchidos pelo Super Admin — registro único (id = "config").
model ConfigLegal {
  id                String   @id @default("config")
  responsavel       String   @default("")
  documento         String   @default("")
  endereco          String   @default("")
  emailPrivacidade  String   @default("")
  encarregadoNome   String   @default("")
  encarregadoEmail  String   @default("")
  foro              String   @default("")
  atualizadoEm      DateTime @updatedAt
}

/// Empresa | IA (etapa 9b — decisões #74 e #77): o que a IA sabe sobre a empresa.
/// Uma por conta (empresa ou individual); o Super Admin tem a dele (superAdminId).
model FichaEmpresa {
  id            String       @id @default(cuid())
  empresaId     String?      @unique
  empresa       Empresa?     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  superAdminId  String?      @unique
  nome          String       @default("")
  endereco      String       @default("")
  telefone      String       @default("")
  whatsapp      String       @default("")
  atividade     String       @default("")
  /// Orientações do suporte (decisão #148): texto do Super Admin lido só pela IA do suporte dos clientes
  orientacoesSuporte String   @default("")
  /// Resumo compacto que a IA monta a partir dos campos e materiais (tamanho máximo fixo)
  resumo        String       @default("")
  resumoEm      DateTime?
  montando      Boolean      @default(false)
  /// Consumo do mês (páginas lidas) para o limite do plano
  mesRef        String       @default("")
  paginasMes    Int          @default(0)
  /// "Como qualificar" (decisão #92): orientação opcional para a IA qualificar os leads; vazio = critério geral
  comoQualificar String       @default("")
  /// Materiais enviados no período atual do plano (decisão #91): "Esquecer" não devolve; zera na renovação
  materiaisPeriodo Int        @default(0)
  atualizadoEm  DateTime     @updatedAt
  materiais     MaterialIA[]
}

enum TipoMaterial {
  LINK
  TEXTO
  IMAGEM
  PDF
}

enum StatusMaterial {
  LENDO
  PRONTO
  ERRO
}

/// Material ensinado à IA. "Esquecer" apaga o material e refaz a ficha.
model MaterialIA {
  id         String         @id @default(cuid())
  fichaId    String
  ficha      FichaEmpresa   @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  tipo       TipoMaterial
  /// Endereço (link) ou nome do arquivo
  origem     String
  status     StatusMaterial @default(LENDO)
  /// Texto lido (cortado num tamanho máximo) e resumo feito pela IA
  conteudo   String         @default("")
  resumo     String         @default("")
  paginas    Int            @default(0)
  erro       String?
  criadoEm   DateTime       @default(now())
  lidoEm     DateTime?

  @@index([fichaId])
}

/// Aviso esperando o resumo de 10 minutos (decisão #94).
model AvisoPendente {
  id         String   @id @default(cuid())
  /// Quem recebe (usuário, Admin da Empresa ou Super Admin)
  usuarioId  String
  texto      String
  criadoEm   DateTime @default(now())

  @@index([usuarioId])
}

enum StatusAnuncio {
  RECEBIDO
  AGUARDANDO_WHATSAPP
  ATENDIDO
  SEM_TELEFONE
  SEM_RECURSO
  ERRO
}

/// Lead recebido pelo endereço de anúncios (Google Ads, Facebook/Instagram via Make/Zapier — decisões #82, #84 e #94).
model LeadAnuncio {
  id          String        @id @default(cuid())
  /// Dono do endereço que recebeu
  usuarioId   String
  origem      String        @default("outro")
  nome        String        @default("")
  telefone    String        @default("")
  email       String        @default("")
  /// Assunto e respostas do formulário, em texto (vai para a IA)
  assunto     String        @default("")
  dados       Json?
  status      StatusAnuncio @default(RECEBIDO)
  /// Lead criado ou encontrado (pode ser de outro usuário da empresa — quem cadastrou primeiro)
  leadId      String?
  erro        String?
  recebidoEm  DateTime      @default(now())
  atendidoEm  DateTime?

  @@index([usuarioId, recebidoEm])
  @@index([status])
}

/// Registro de ações (tela Logs — decisão #99). Guardado por 90 dias.
model Log {
  id        String   @id @default(cuid())
  criadoEm  DateTime @default(now())
  /// Conta (para o Admin da Empresa ver os da empresa) e quem fez
  empresaId String?
  usuarioId String?
  /// Nome e e-mail copiados na hora (o usuário pode ser excluído depois)
  quem      String   @default("")
  /// ENTRADA, SENHA, USUARIOS, LEADS, CAMPANHAS, WHATSAPP
  tipo      String
  texto     String
  ip        String?

  @@index([empresaId, criadoEm])
  @@index([criadoEm])
}

/// Aparelho inscrito para receber notificações do app (PWA — decisão #99).
model PushInscricao {
  id        String   @id @default(cuid())
  usuarioId String
  endpoint  String   @unique
  p256dh    String
  auth      String
  aparelho  String   @default("")
  criadoEm  DateTime @default(now())

  @@index([usuarioId])
}

/// Suporte em tempo real (decisão #102): uma conversa por cliente com o Super Admin.
model SuporteConversa {
  id               String   @id @default(cuid())
  usuarioId        String   @unique
  ultimaMensagemEm DateTime @default(now())
  /// Não lidas por quem atende (Super Admin) e pelo cliente
  naoLidasSuporte  Int      @default(0)
  naoLidasCliente  Int      @default(0)
  /// IA no suporte dos clientes (decisão #146): pausada quando o Super Admin assume ou a IA passa para o atendente
  iaPausada        Boolean  @default(false)
  iaPausaMotivo    String?
  /// Último aviso ao Super Admin enquanto a IA atendia (no máximo 1 a cada 30 min)
  ultimoAvisoEm    DateTime?
  /// Atendimento encerrado por inatividade do cliente (decisão #156); a próxima mensagem do cliente (ou do Super Admin) reabre
  encerradaEm      DateTime?
  /// O Super Admin chamou o cliente: o chat abre sozinho na tela dele
  chamadoEm        DateTime?
  mensagens        SuporteMensagem[]

  @@index([ultimaMensagemEm])
}

model SuporteMensagem {
  id          String          @id @default(cuid())
  conversaId  String
  conversa    SuporteConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  /// CLIENTE ou SUPORTE
  autor       String
  autorId     String
  texto       String          @default("")
  /// texto, imagem ou documento (anexo guardado no serviço 24/7 como "sup-<id>")
  tipo        String          @default("texto")
  arquivoNome String?
  arquivoTipo String?
  criadoEm    DateTime        @default(now())

  @@index([conversaId, criadoEm])
  @@index([criadoEm])
}

/// Mensagem do Super Admin para os usuários (popup com OK — decisão #102).
model Comunicado {
  id        String   @id @default(cuid())
  titulo    String
  texto     String
  link      String?
  validoAte DateTime?
  /// Descrição de quem recebeu (ex.: "Todos", "Empresa Exemplo", "3 selecionados")
  publico   String
  autorId   String
  criadoEm  DateTime @default(now())
  destinos  ComunicadoDestino[]
}

model ComunicadoDestino {
  id           String     @id @default(cuid())
  comunicadoId String
  comunicado   Comunicado @relation(fields: [comunicadoId], references: [id], onDelete: Cascade)
  usuarioId    String
  lidoEm       DateTime?

  @@unique([comunicadoId, usuarioId])
  @@index([usuarioId, lidoEm])
}

/// Modo manutenção (decisão #103): ligado pelo deploy/atualizar.sh durante as atualizações.
/// Uma linha só (id "geral"), lida pelo site e pelo serviço 24/7.
model Manutencao {
  id     String    @id @default("geral")
  ligada Boolean   @default(false)
  desde  DateTime?
  motivo String?
}

/// Chat para interessados (decisão #104): quem ainda não é cliente conversa pela tela de Planos.
/// A IA responde primeiro; o Super Admin assume no Atendimento (aba Interessados). Guardado 180 dias.
model Interessado {
  id                String   @id @default(cuid())
  /// Hash do código guardado no aparelho do visitante (cookie de 30 dias)
  tokenHash         String   @unique
  nome              String
  /// Só números, com DDI (ex.: 5511999998888)
  whatsapp          String
  email             String?
  aceitouEm         DateTime
  ip                String?
  iaPausada         Boolean  @default(false)
  iaPausaMotivo     String?
  temperatura       String?
  naoLidasSuporte   Int      @default(0)
  naoLidasVisitante Int      @default(0)
  /// Último sinal do visitante com o chat aberto (online = últimos 2 minutos)
  vistoEm           DateTime?
  ultimoAvisoEm     DateTime?
  ultimaMensagemEm  DateTime @default(now())
  criadoEm          DateTime @default(now())
  mensagens         InteressadoMensagem[]

  @@index([ultimaMensagemEm])
  @@index([email])
  @@index([whatsapp])
}

model InteressadoMensagem {
  id            String      @id @default(cuid())
  interessadoId String
  interessado   Interessado @relation(fields: [interessadoId], references: [id], onDelete: Cascade)
  /// VISITANTE, IA ou SUPORTE
  autor         String
  autorId       String?
  texto         String      @default("")
  /// texto, imagem ou documento (anexo só do Super Admin, guardado no serviço 24/7 como "int-<id>")
  tipo          String      @default("texto")
  arquivoNome   String?
  arquivoTipo   String?
  criadoEm      DateTime    @default(now())

  @@index([interessadoId, criadoEm])
}

// ===================== Gestão financeira (decisão #106) — só o Super Admin =====================

enum TipoLancamento {
  RECEITA
  DESPESA
}

enum SituacaoLancamento {
  PENDENTE
  PAGO
  CANCELADO
}

/// Categorias de receita e despesa (as prontas têm "padrao"; o Super Admin cria outras)
model CategoriaFinanceira {
  id          String         @id @default(cuid())
  tipo        TipoLancamento
  nome        String
  padrao      Boolean        @default(false)
  ativa       Boolean        @default(true)
  ordem       Int            @default(100)
  lancamentos Lancamento[]
  fixas       DespesaFixa[]

  @@unique([tipo, nome])
}

/// Contas bancárias (opcional em cada lançamento)
model ContaBancaria {
  id          String       @id @default(cuid())
  nome        String       @unique
  ativa       Boolean      @default(true)
  criadoEm    DateTime     @default(now())
  lancamentos Lancamento[]
  fixas       DespesaFixa[]
}

/// Receita ou despesa. Valor em centavos (estorno = receita negativa, ligada à receita original).
model Lancamento {
  id               String              @id @default(cuid())
  tipo             TipoLancamento
  categoriaId      String?
  categoria        CategoriaFinanceira? @relation(fields: [categoriaId], references: [id])
  descricao        String
  valor            Int
  vencimento       DateTime
  pagoEm           DateTime?
  situacao         SituacaoLancamento  @default(PENDENTE)
  contaId          String?
  conta            ContaBancaria?      @relation(fields: [contaId], references: [id])
  /// MANUAL, PEDIDO, FIXA, IA ou ESTORNO
  origem           String              @default("MANUAL")
  /// Chave das entradas automáticas (não repete): "pedido:<id>", "fixa:<id>:2026-11", "ia:2026-10", "estorno:<id>"
  chaveAuto        String?             @unique
  pedidoId         String?
  pedido           Pedido?             @relation(fields: [pedidoId], references: [id])
  despesaFixaId    String?
  despesaFixa      DespesaFixa?        @relation(fields: [despesaFixaId], references: [id])
  estornoDeId      String?
  observacao       String?
  /// Comprovante (PDF/imagem) guardado no serviço 24/7 como "fin-<id>"
  comprovanteNome  String?
  comprovanteTipo  String?
  criadoPor        String?
  criadoEm         DateTime            @default(now())
  atualizadoEm     DateTime            @updatedAt

  @@index([tipo, situacao, vencimento])
  @@index([pagoEm])
}

/// Despesas fixas mensais: lançadas sozinhas todo mês como "pendente"
model DespesaFixa {
  id            String              @id @default(cuid())
  descricao     String
  valor         Int
  diaVencimento Int
  categoriaId   String?
  categoria     CategoriaFinanceira? @relation(fields: [categoriaId], references: [id])
  contaId       String?
  conta         ContaBancaria?      @relation(fields: [contaId], references: [id])
  ativa         Boolean             @default(true)
  criadoEm      DateTime            @default(now())
  lancamentos   Lancamento[]
}

/// Disponibilidade medida (decisão #109): o serviço 24/7 soma 1 a cada minuto que está no ar, por hora.
/// Uptime = minutos registrados ÷ minutos do período (últimos 30 dias). Guardado 35 dias.
model Disponibilidade {
  hora    DateTime @id
  minutos Int      @default(0)
}

/// Aviso (webhook) recebido do Asaas (decisões #115 e #117, etapa C): guardado antes de processar, para responder rápido
/// ao Asaas e poder reprocessar. "eventoId" é o id do evento no Asaas (não repete o mesmo aviso).
model AvisoAsaas {
  id           String    @id @default(cuid())
  eventoId     String    @unique
  evento       String
  /// Cobrança no Asaas (payment.id) e código do pedido (payment.externalReference)
  cobrancaId   String?
  referencia   String?
  dados        Json
  recebidoEm   DateTime  @default(now())
  processadoEm DateTime?
  /// O que foi feito (ex.: "Pedido confirmado", "Ignorado: evento sem ação") ou o erro, para conferir
  resultado    String?
  erro         String?
  tentativas   Int       @default(0)

  @@index([processadoEm])
  @@index([cobrancaId])
}

/// Serviço 24/7 no ar (decisão #133): só um por vez. O serviço que está rodando confirma a cada 20 s;
/// outro só assume quando este libera (desligamento normal) ou para de confirmar por 60 s.
model ServicoInstancia {
  id      String   @id
  dono    String
  vistoEm DateTime
}

/// Fila de saída do número da plataforma (decisão #143): cadência, limite por dia, prioridade e validade.
/// prioridade: ALTA (Super Admin, suporte, segurança — nunca espera o limite) | NORMAL (avisos aos usuários e links de renovação)
/// situacao: PENDENTE | ENVIADA | EXPIRADA | FALHOU
model MensagemPlataforma {
  id        String    @id @default(cuid())
  para      String
  texto     String
  prioridade String   @default("NORMAL")
  situacao  String    @default("PENDENTE")
  erro      String?
  tentativas Int      @default(0)
  criadoEm  DateTime  @default(now())
  /// Passou disso e ainda não saiu: expira (ninguém recebe aviso velho)
  expiraEm  DateTime
  enviadaEm DateTime?

  @@index([situacao, prioridade, criadoEm])
  @@index([enviadaEm])
}

/// Último estado (cor) de cada ponto de atendimento por IA já avisado ao Super Admin (decisão #149): LEADS, CAMPANHAS, SUPORTE, VISITANTE
model EstadoIAPonto {
  ponto      String   @id
  /// VERDE | AMARELO | VERMELHO (manutenção conta como VERDE: não avisa a cada atualização)
  estado     String
  desde      DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

/// Aviso de serviço 24/7 fora do ar (decisão #151): guarda se já avisou o Super Admin por e-mail desta queda (um e-mail por queda)
model AlertaServico {
  id           String    @id
  foraDesde    DateTime?
  avisouEm     DateTime?
  atualizadoEm DateTime  @updatedAt
  /// Avisos da VPS (decisão #171): quantas leituras seguidas já vieram com problema, quando foi o último e-mail e o nível ("aviso" | "critico")
  contagem      Int       @default(0)
  ultimoAvisoEm DateTime?
  nivel         String?
}

/// Controle de tentativas de entrada e de pedidos de recuperação (decisão #160 — S5 do Módulo 1).
/// chave: "par:e-mail|endereço" (erros de senha de um endereço), "conta:e-mail" (erros somados de todos os endereços),
/// "rec:e-mail" (pedidos de recuperação na hora) e "aviso:e-mail" (último aviso ao dono). Vale também para e-mail sem conta
/// (para as respostas serem iguais — decisão #159). Linhas velhas são apagadas pela rotina de 5 minutos.
model TentativaLogin {
  chave        String    @id
  falhas       Int       @default(0)
  desde        DateTime  @default(now())
  bloqueadoAte DateTime?
  atualizadoEm DateTime  @updatedAt
}
