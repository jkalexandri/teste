# Serviço 24/7 (VPS). Copie para apps/worker/.env e preencha. NUNCA envie o .env para o GitHub.

# Mesmo banco do site (PostgreSQL na VPS — decisão #99)
DATABASE_URL="postgresql://usuario:senha@host:5432/filapro"

# Token compartilhado com o site: o MESMO valor vai em WORKER_TOKEN na Vercel.
# Gere com: openssl rand -hex 32
WORKER_TOKEN=""

# Segredo que criptografa as credenciais do WhatsApp no banco. Gere com: openssl rand -hex 32
# Se trocar, todas as sessões precisam ler o QR Code de novo.
CHAVE_CRIPTO=""

# O Caddy recebe o HTTPS e repassa para esta porta local
PORTA=4000
HOST=127.0.0.1
NIVEL_LOG=info

# Pasta dos anexos das campanhas (imagem, PDF, vídeo, áudio)
PASTA_ARQUIVOS=/opt/filapro/arquivos

# Notificações no celular (decisão #99). Gere com: bash deploy/gerar-segredos.sh
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
