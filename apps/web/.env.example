# Ambiente: development | staging | production
# Em "production" os botões de acesso demo do login ficam ocultos.
NEXT_PUBLIC_APP_ENV=development

# Banco PostgreSQL (Vercel/Neon em produção)
DATABASE_URL="postgresql://usuario:senha@host:5432/filapro"

# E-mail (Resend). Sem a chave, em desenvolvimento os e-mails aparecem no console.
RESEND_API_KEY=""
EMAIL_FROM="FilaPro Leads <nao-responda@filaproleads.com.br>"

# Endereço público do site (links nos e-mails)
NEXT_PUBLIC_SITE_URL="https://filaproleads.com.br"

# Segredo do agendador diário (Vercel Cron) — renovação
CRON_SECRET=""

# Serviço 24/7 do WhatsApp (VPS). Sem estas variáveis, as telas de WhatsApp mostram
# "serviço fora do ar" e os avisos aparecem só no console (em desenvolvimento).
WORKER_URL="https://api.filaproleads.com.br"
# Mesmo valor de WORKER_TOKEN do apps/worker/.env
WORKER_TOKEN=""

# Segredo que criptografa as chaves da IA no banco: o MESMO valor de CHAVE_CRIPTO do apps/worker/.env
CHAVE_CRIPTO=""
